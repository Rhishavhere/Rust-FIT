{
  "$schema": "https://schema.tauri.app/config/2/stable",
  "productName": "FIT",
  "version": "0.1.0",
  "identifier": "fit.hackathon.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FIT",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "capabilities": ["default"]
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
